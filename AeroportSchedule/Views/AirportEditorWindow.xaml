<Window x:Class="AeroportSchedule.Views.AirportEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AeroportSchedule.Views"
        mc:Ignorable="d"
       Title="{Binding Title}"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Код IATA:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,6" MaxLength="3"
                   Text="{Binding Airport.IATACode, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Код ICAO:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,6" MaxLength="4"
                   Text="{Binding Airport.ICAOCode, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Название:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,6"
                   Text="{Binding Airport.Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Город:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,6"
                   Text="{Binding Airport.City, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Страна:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,6"
                   Text="{Binding Airport.Country, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Часовой пояс:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,6"
                   Text="{Binding Airport.TimeZone, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,20,0,0">
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Width="110" Margin="0,0,10,0" Padding="0,4"
                    IsDefault="True"/>
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Width="110" Padding="0,4"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
