<Window x:Class="AeroportSchedule.Views.AircraftListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AeroportSchedule.Views"
        mc:Ignorable="d"
        Title="Воздушные суда" Height="500" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="10,4"/>
        </StackPanel>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Aircrafts}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Бортовой №" Binding="{Binding RegistrationNo}"  Width="120"/>
                <DataGridTextColumn Header="Тип ВС"     Binding="{Binding AircraftType.Model}" Width="180"/>
                <DataGridTextColumn Header="Авиакомпания" Binding="{Binding Airline.Name}"   Width="180"/>
                <DataGridTextColumn Header="Год выпуска" Binding="{Binding ManufactureYear}" Width="100"/>
                <DataGridTextColumn Header="Статус"     Binding="{Binding Status}"          Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
