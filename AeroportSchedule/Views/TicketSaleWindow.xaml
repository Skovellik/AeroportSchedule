<Window x:Class="AeroportSchedule.Views.TicketSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AeroportSchedule.Views"
        mc:Ignorable="d"
       WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Номер билета -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер билета:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,6"
                   Text="{Binding TicketNumber}" IsReadOnly="True"
                   Background="#F0F0F0"/>

        <!-- Рейс -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Рейс:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox  Grid.Row="1" Grid.Column="1" Margin="0,6"
                   ItemsSource="{Binding Flights}"
                   SelectedItem="{Binding SelectedFlight}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding FlightNumber, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding Airport.IATACode, Mode=OneWay}"/>
                        <Run Text=" → "/>
                        <Run Text="{Binding Airport1.IATACode, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding DepartureTime, StringFormat=dd.MM.yyyy HH:mm, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Пассажир -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Пассажир:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,6"
                   ItemsSource="{Binding Passengers}"
                   SelectedItem="{Binding SelectedPassenger}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding LastName, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding FirstName, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding PassportNumber, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Место -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Место:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,6"
                   Text="{Binding SeatNumber, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Класс -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Класс:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox  Grid.Row="4" Grid.Column="1" Margin="0,6"
                   SelectedValue="{Binding TicketClass}"
                   SelectedValuePath="Content">
            <ComboBoxItem Content="Эконом"/>
            <ComboBoxItem Content="Бизнес"/>
            <ComboBoxItem Content="Первый"/>
        </ComboBox>

        <!-- Цена -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Цена:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,6"
                   Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Статус -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Статус:"
                   VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox  Grid.Row="6" Grid.Column="1" Margin="0,6"
                   SelectedValue="{Binding Status}"
                   SelectedValuePath="Content">
            <ComboBoxItem Content="Оплачен"/>
            <ComboBoxItem Content="Зарегистрирован"/>
            <ComboBoxItem Content="Возвращён"/>
        </ComboBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,20,0,0">
            <Button Content="Оформить"
                    Command="{Binding SaveCommand}"
                    Width="120" Margin="0,0,10,0" Padding="0,4"
                    IsDefault="True"/>
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Width="120" Padding="0,4"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
