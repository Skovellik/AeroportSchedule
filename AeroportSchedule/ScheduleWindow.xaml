<Window x:Class="AeroportSchedule.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AeroportSchedule"
        mc:Ignorable="d"
        Title="Расписание рейсов аэропорта" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Обновить"        Command="{Binding RefreshCommand}"   Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Добавить рейс"   Command="{Binding AddFlightCommand}" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Редактировать"   Command="{Binding EditFlightCommand}" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Удалить"         Command="{Binding DeleteFlightCommand}" Margin="0,0,20,0" Padding="10,4"/>
            <Button Content="Аэропорты"       Command="{Binding AirportsCommand}"  Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Авиакомпании"    Command="{Binding AirlinesCommand}"  Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="ВС"              Command="{Binding AircraftsCommand}" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Пассажиры"       Command="{Binding PassengersCommand}" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Продать билет"   Command="{Binding SellTicketCommand}" Padding="10,4"/>
        </WrapPanel>

        <!-- Поиск -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Таблица расписания -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Flights}"
                  SelectedItem="{Binding SelectedFlight}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Рейс"          Binding="{Binding FlightNumber}"  Width="90"/>
                <DataGridTextColumn Header="Авиакомпания"  Binding="{Binding AirlineName}"   Width="160"/>
                <DataGridTextColumn Header="Вылет (код)"   Binding="{Binding DepartureCode}" Width="90"/>
                <DataGridTextColumn Header="Вылет (город)" Binding="{Binding DepartureCity}" Width="150"/>
                <DataGridTextColumn Header="Прилёт (код)"  Binding="{Binding ArrivalCode}"   Width="90"/>
                <DataGridTextColumn Header="Прилёт (город)" Binding="{Binding ArrivalCity}"   Width="150"/>
                <DataGridTextColumn Header="Вылет"         Binding="{Binding DepartureTime, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Прилёт"        Binding="{Binding ArrivalTime, StringFormat=dd.MM.yyyy HH:mm}"   Width="130"/>
                <DataGridTextColumn Header="ВС"            Binding="{Binding AircraftModel}" Width="120"/>
                <DataGridTextColumn Header="Статус"        Binding="{Binding Status}"        Width="120"/>
                <DataGridTextColumn Header="Гейт"          Binding="{Binding GateNumber}"    Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
